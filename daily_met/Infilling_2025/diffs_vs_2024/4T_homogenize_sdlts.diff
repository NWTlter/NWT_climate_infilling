+# (2025: made a function so the pre-HMP series gets the same flags)
+infill_flags <- function(pred){
+  pred$flag_1 <- NA
+  pred$flag_1[is.na(pred$method)] <- "A"
+  # flagging based on tmean pval
+  pred$flag_1[grepl("multi", pred$method) & pred$airtemp_avg_pval <= 0.05] <- "D"
+  pred$flag_1[grepl("multi", pred$method) & pred$airtemp_avg_pval > 0.05] <- "E"
+  pred$flag_1[grepl("moving", pred$method) & pred$airtemp_avg_pval <= 0.05] <- "B"
+  pred$flag_1[grepl("moving", pred$method) & pred$airtemp_avg_pval > 0.05] <- "C"
+
+  # flagging for tmax/tmin derivation
+  pred$flag_2 <- NA
+  pred$flag_2[is.na(pred$method)] <- "A"
+  pred$flag_2[pred$airtemp_max_method == "predicted" & pred$airtemp_min_method == "predicted"] <- "B"
+  # if raw adjustment failed, assign B*
+  pred$flag_2[grepl("failed", pred$airtemp_max_method)] <- "B*"
+  pred$flag_2[grepl("adjusted$", pred$airtemp_max_method) & pred$airtemp_min_method == "raw"] <- "C"
+  pred$flag_2[pred$airtemp_max_method == "raw" & grepl("dtr adjusted$", pred$airtemp_min_method)] <- "D"
+
+  # flagging for dtr pval
+  pred$flag_3 <- NA
+  pred$flag_3[is.na(pred$method)] <- "A"
+  pred$flag_3[pred$dtr_pval <= 0.05] <- "B"
+  pred$flag_3[pred$dtr_pval > 0.05] <- "C"
+  return(pred)
+}
+sdlhmp_pred <- infill_flags(sdlhmp_pred)
 
