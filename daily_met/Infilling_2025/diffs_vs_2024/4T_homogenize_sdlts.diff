+# -- 2025: PRE-HMP LOGGERS (1986-2017) -----
+# 3T re-infilled CTW's homogenized cr21x/cr23x/cr1000 series (already adjusted to the HMPs), so its
+# values are the homogenized values. CTW's adjustments, qc flags and raw values are carried over;
+# gapfilled = homogenized - adjustment, as in CTW's posted series.
+sdlhomog_pred$airtemp_avg_method[grepl("m", sdlhomog_pred$method)] <- "predicted"
+sdlhomog_pred <- infill_flags(sdlhomog_pred)
+
+sdlhomog_ctw <- sdlhomog_qc %>%
+  # 2025 QC removals, else CTW's qc flag
+  mutate(qcflag = ifelse(is.na(qcflag), ctw_qcflag, qcflag),
+         metric = gsub("airtemp_", "", metric)) %>%
+  dplyr::select(date, ctw_logger, metric, ctw_adjustment, qcflag, ctw_raw, ctw_raw_flag) %>%
+  pivot_wider(names_from = metric, values_from = c(ctw_adjustment, qcflag, ctw_raw, ctw_raw_flag))
+
+edi_dat_crs <- left_join(sdlhomog_pred, sdlhomog_ctw, by = "date") %>%
+  transmute(LTER_site = "NWT", local_site = "sdl", logger = ctw_logger, date, yr, mon, doy,
+            airtemp_max_homogenized = airtemp_max, airtemp_avg_homogenized = airtemp_avg,
+            airtemp_min_homogenized = airtemp_min, dtr_homogenized = airtemp_max - airtemp_min,
+            airtemp_max_adjustment = ctw_adjustment_max, airtemp_avg_adjustment = ctw_adjustment_avg,
+            airtemp_min_adjustment = ctw_adjustment_min,
+            airtemp_max_gapfilled = airtemp_max - ctw_adjustment_max, airtemp_min_gapfilled = airtemp_min - ctw_adjustment_min,
+            airtemp_avg_gapfilled = airtemp_avg - ctw_adjustment_avg,
+            dtr_gapfilled = airtemp_max_gapfilled - airtemp_min_gapfilled,
+            flag_1, flag_2, flag_3, source_station = source.station,
+            airtemp_avg_pval, airtemp_avg_r2, num_obs_in_airtemp_avg_regression = airtemp_avg_n.obs, airtemp_avg_equation,
+            dtr_pval, dtr_r2, num_obs_in_dtr_regression = dtr_n.obs, dtr_equation,
+            airtemp_max_qcflag = qcflag_max, raw_airtemp_max = ctw_raw_max, raw_airtemp_max_flag = ctw_raw_flag_max,
+            airtemp_min_qcflag = qcflag_min, raw_airtemp_min = ctw_raw_min, raw_airtemp_min_flag = ctw_raw_flag_min,
+            airtemp_avg_qcflag = qcflag_avg, raw_airtemp_avg = ctw_raw_avg, raw_airtemp_avg_flag = ctw_raw_flag_avg)
+
+# the two series meet at 2018-01-01 (first HMP day)
+stopifnot(max(edi_dat_crs$date) < min(edi_dat$date))
+edi_dat <- bind_rows(edi_dat_crs, edi_dat) %>%
+  data.frame()
